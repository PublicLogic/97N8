{
  "name": "boudreau-gardner-site",
  "version": "2.0.0",
  "private": true,
  "description": "Static exploratory site for Nate Boudreau, Gardner, Massachusetts.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "lint:html": "html-validate \"public/**/*.html\"",
    "lint:css": "stylelint \"public/**/*.css\"",
    "lint:format": "prettier --check .",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:format",
    "format": "prettier --write .",
    "test": "playwright test",
    "check": "npm run lint && npm test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@playwright/test": "1.48.2",
    "html-validate": "8.24.2",
    "prettier": "3.3.3",
    "stylelint": "16.10.0",
    "stylelint-config-standard": "36.0.1"
  }
}
